# Copy to .env and fill in. Never commit .env — it is gitignored.
# Everything here has a working default except MONGO_URI and GROQ_API_KEY;
# the pipeline runs without either.

# ============================ Storage ============================
# Percent-encode special characters in the password (@ : / ? # [ ] %).
# No angle brackets. Without this, results go to output/extractions.jsonl.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=ai_scraping_pipeline
MONGO_COLLECTION=extractions

# Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# ============================ Identity ============================
# Sent on every request. An honest, contactable UA turns "some bot is hammering
# us" into an email rather than a firewall rule. Point CONTACT_URL somewhere real.
BOT_NAME=UniversalExtractor
CONTACT_URL=https://example.invalid/bot
# Setting this to true sends a Chrome UA instead. Off by default: pretending to
# be a browser while behaving like a crawler is what robots.txt exists to avoid.
SPOOF_BROWSER_UA=false

# ======================= Compliance (Phase 1) =======================
RESPECT_ROBOTS=true
# What to do when robots.txt itself is unreachable: allow | deny.
ROBOTS_ON_UNAVAILABLE=allow
# Per-host politeness. These are the floor; a site's Crawl-delay only slows it.
REQUESTS_PER_SECOND=1.0
RATE_BURST=3
MAX_CONCURRENCY_PER_HOST=2
# A site asking for a longer gap than this is asking you not to crawl it.
MAX_CRAWL_DELAY=30
DETECT_BLOCKS=true
BREAKER_FAILURE_THRESHOLD=8
BREAKER_COOLDOWN=300
# SSRF guard. Leave false unless you are deliberately scraping localhost.
ALLOW_PRIVATE_ADDRESSES=false
# HOST_ALLOWLIST=example.com,other.test
# HOST_DENYLIST=

# ========================== Fetching ==========================
# PROXY_URL=http://user:pass@proxy.example.com:8080
# Some servers (government and university sites especially) never implemented
# RFC 5746 secure renegotiation, and OpenSSL 3 refuses those handshakes — the
# symptom is UNSAFE_LEGACY_RENEGOTIATION_DISABLED on a site that curl fetches
# fine. This re-opens a known MITM window, so turn it on per-need, not always.
TLS_ALLOW_LEGACY_RENEGOTIATION=false
USE_BROWSER_FALLBACK=true
STATIC_TIMEOUT=20
BROWSER_TIMEOUT_MS=30000
MAX_RETRIES=3
MAX_REDIRECTS=10
MAX_CONTENT_BYTES=67108864

# ====================== Universal input (Phase 2) ======================
MAX_RECURSION_DEPTH=2
MAX_ARCHIVE_MEMBERS=200
MAX_FEED_ENTRIES=100
MAX_SITEMAP_URLS=5000
# markitdown | docling (docling is slower but better on multi-column PDFs)
DOCUMENT_BACKEND=markitdown
OCR_ENABLED=true
# auto | vision | tesseract
OCR_BACKEND=auto
LIVESTREAM_SEGMENT_SECONDS=120
LIVESTREAM_MAX_MINUTES=120

# ================== Extraction cascade (Phase 3) ==================
ENABLE_TIER0_CACHE=true
ENABLE_TIER1_STRUCTURED=true
ENABLE_TIER2_SELECTORS=true
ENABLE_TIER3_LLM=true
# A tier's answer is accepted only if it filled this share of the fields.
MIN_FILL_RATE=0.5
# A stored selector spec below this is treated as drifted and relearned.
SPEC_DRIFT_FILL_RATE=0.4
SPEC_MAX_AGE_DAYS=30

# auto | ollama | groq. "auto" prefers Groq when a key is set.
LLM_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
# qwen2.5:3b over llama3.2:3b on measurement (bench/graph_models.py): edge
# directions 3 right / 0 reversed against 2 / 2, alias judgement 4/4 against
# 3/4, same size and speed. Re-run the benchmark if you change this.
AI_MODEL_NAME=qwen2.5:3b
AI_TIMEOUT=300
# GROQ_API_KEY=
# Structured outputs are per-model on Groq; openai/gpt-oss-* and qwen support
# json_schema. Others fall back to JSON mode plus validation on this side.
GROQ_MODEL=llama-3.3-70b-versatile
# Backend for calls a user is waiting on — query understanding, graph traversal.
# Small prompts at low volume, where a hosted model's ~500 tok/s against a local
# ~35 tok/s is the whole latency budget. Leave unset to use LLM_BACKEND for
# everything. Bulk ingest deliberately stays local: at a free tier's ~8K tokens
# per minute and ~3.1K tokens per chunk, hosted manages about two chunks a
# minute, which is slower than local despite each call being faster.
# LLM_INTERACTIVE_BACKEND=groq
# Hard switch: never send page content to a hosted model.
LOCAL_ONLY=false
MAX_CHUNK_SIZE=12000
# Ollama unloads the model 5 minutes after the last call by default; reloading
# it measured ~2.2s against ~170ms warm.
OLLAMA_KEEP_ALIVE=30m
# Prompt and generation share this window. The 4096 default is too small for a
# full chunk plus a long answer, and Ollama silently drops the front of the
# prompt when it overflows. Costs KV cache: 2.0 GB resident at 4096, 3.0 GB at
# 8192 for llama3.2:3b.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096

# ==================== Performance (Phase 4) ====================
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_SECONDS=86400
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_TTL_DAYS=30
RAW_STORE_ENABLED=true
RAW_STORE_TTL_DAYS=14
# auto | mlx | faster. Benchmark first:
#   PYTHONPATH=. ./venv/bin/python -m pipeline.transcribe.bench your-audio.mp3
WHISPER_BACKEND=auto
WHISPER_MODEL_SIZE=base
MLX_WHISPER_MODEL=mlx-community/whisper-base-mlx
# WHISPER_LANGUAGE=en
PRELOAD_MODELS=true

# ======================= Trust (Phase 5) =======================
VALIDATE_OUTPUT=true
# false keeps a flagged record (inspectable); true discards it.
REJECT_ON_VALIDATION_FAILURE=false
DEDUPE_ENABLED=true
SIMHASH_MAX_DISTANCE=3
DRIFT_ENABLED=true
DRIFT_MIN_SAMPLES=20
DRIFT_FILL_RATE_DROP=0.3

# ====================== Indexing (Phase 6) ======================
# On by default: retrieval is the point of indexing, and a feature that is off
# by default is a feature nobody has. Costs a ~130 MB embedding model resident
# per cpu worker. Per request, POST /api/v1/extract accepts {"index": false}.
INDEX_ENABLED=true
# agentic | fixed | semantic | hierarchical | llm
# "agentic" reads the document's shape: headings mean hierarchical, lines too
# short to be prose mean OCR damage and a model, length alone means semantic.
INDEX_CHUNK_STRATEGY=agentic
# Whether the agentic router may pick the model-assisted splitter. Off: indexing
# is on by default and must not silently make a model call per document. It also
# misfires — a page of quotes and tag lists has short lines and reads as OCR
# damage, which cost 39s and 78 chunks for one HTML page.
INDEX_AGENTIC_ALLOW_LLM=false
# Characters. Not the same knob as MAX_CHUNK_SIZE above, which is how much text
# the extraction stage sends to a model.
INDEX_CHUNK_SIZE=1000
INDEX_CHUNK_OVERLAP=200
# Ceiling on model calls for one document under the "llm" strategy.
INDEX_LLM_MAX_WINDOWS=8
# local_bge (384d, ~130MB) | local_e5 | cohere | voyage
# The hosted ones need `pip install cohere voyageai` and their API keys.
INDEX_DENSE_PROVIDER=local_bge
# Needs `pip install presidio-analyzer presidio-anonymizer` and
# `python -m spacy download en_core_web_lg`. Hundreds of MB, English only.
INDEX_PII_REMOVAL=false
# Text past this is dropped rather than handed to the broker as a payload
# measured in megabytes.
INDEX_MAX_TEXT_CHARS=400000
# "auto" means CPU. Metal has been measured killing both the prefork worker and
# the uvicorn process on the first embedding call. BGE-small does 32 chunks in
# ~0.25s on CPU, so the GPU is not worth a crash. Set mps only where verified.
INDEX_EMBED_DEVICE=auto
LANCE_DB_DIR=./lance_data
# One table per embedding model — a mismatched write is refused.
LANCE_TABLE_NAME=chunks
# Below this many rows no ANN index is built: IVF_PQ trains on the data, and a
# flat scan under a few thousand vectors is both faster and exact.
INDEX_ANN_MIN_ROWS=5000
# num_sub_vectors must divide the embedding width: 384/48 = 8 bytes per vector.
INDEX_IVF_PARTITIONS=256
INDEX_PQ_SUB_VECTORS=48

# ====================== Retrieval (Phase 7) ======================
# One model call does self-query, decomposition and step-back together. Simple
# questions skip it entirely, which is the largest latency saving available.
RETRIEVE_REWRITE_ENABLED=true
RETRIEVE_SIMPLE_QUERY_WORDS=8
RETRIEVE_MAX_SUBQUERIES=4
RETRIEVE_PLAN_CACHE_SIZE=256
RETRIEVE_TOP_K=10
# Candidates each leg fetches before fusion. Fusion can only reorder what it got.
RETRIEVE_CANDIDATES=50
# rrf | alpha. RRF uses rank only, so it is unaffected by the two legs scoring
# on unrelated scales. alpha is a weighted sum of normalised scores.
RETRIEVE_FUSION=rrf
# Under alpha: weight on the dense leg. 1.0 pure vector, 0.0 pure BM25.
RETRIEVE_ALPHA=0.7
RETRIEVE_RRF_K=60
# A cross-encoder is another model resident on an 8 GB host.
RETRIEVE_RERANK=false
RETRIEVE_RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVE_RERANK_CANDIDATES=20
# IVF probes and exact rescoring. refine_factor recovers most of what PQ costs.
RETRIEVE_NPROBES=20
RETRIEVE_REFINE_FACTOR=10

# ====================== Answering (Phase 8) ======================
# How many retrieved passages go in front of the model. More context is not more
# accuracy: past a handful the answer drifts toward whatever is longest.
ANSWER_MAX_PASSAGES=6
ANSWER_MAX_TRIPLES=20
# Characters of any single passage. A whole page in one slot crowds out the rest.
ANSWER_MAX_PASSAGE_CHARS=1200

# ================== Knowledge graph (Phase 7) ====================
# On by default: the graph is half of what hybrid + graph retrieval means, and
# a graph nobody builds answers no questions. One model call per MAX_CHUNK_SIZE
# window of a document, so it is the slowest part of ingest.
GRAPH_ENABLED=true
# Cache extraction on the chunk's content hash. Re-ingesting unchanged text
# measured 23.7s the first time and 0.14s after.
GRAPH_CACHE_ENABLED=true
# Flip relationships whose direction is provably backwards, checked against
# entity types and the word order of the sentence. Measured on llama3.2:3b:
# 2 right / 2 reversed becomes 4 right / 0 reversed.
GRAPH_VALIDATE_DIRECTION=true
# gliner | llm. GLiNER scores spans instead of generating JSON: 166ms against
# ~10s, and 11/11 entities against the model's 10/11. The model is still asked
# for relationships. Falls back to "llm" if the package is not installed.
GRAPH_ENTITY_BACKEND=gliner
GRAPH_NER_MODEL=urchade/gliner_small-v2.1
# Zero-shot, so these are just words — change them to change what is found.
GRAPH_NER_LABELS=person,organization,location,product,project,technology,event
GRAPH_NER_THRESHOLD=0.5
KUZU_DB_PATH=./kuzu_db
# Ceiling on model calls for one document's graph. Long text is windowed, not
# truncated — a long PDF used to yield a graph of its first few pages only.
GRAPH_MAX_WINDOWS=8
GRAPH_MAX_HOPS=2
# A well-connected node fans out combinatorially at two hops.
GRAPH_MAX_TRIPLES=50
GRAPH_SEED_ENTITIES=3
GRAPH_RESOLUTION_THRESHOLD=0.70
# Let a model write the traversal query. Off by default: neither local model
# writes Cypher Kuzu reliably accepts (qwen 2/5, llama 1/5), so the template
# answers anyway — 39ms against the agent's 1.9s for identical triples.
GRAPH_CYPHER_AGENT=false

# ========================= Operations =========================
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
API_BASE_URL=http://127.0.0.1:8000
