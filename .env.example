# Copy to .env and fill in. Never commit .env — it is gitignored.
# Everything here has a working default except MONGO_URI and GROQ_API_KEY;
# the pipeline runs without either.

# ============================ Storage ============================
# Percent-encode special characters in the password (@ : / ? # [ ] %).
# No angle brackets. Without this, results go to output/extractions.jsonl.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=ai_scraping_pipeline
MONGO_COLLECTION=extractions

# Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# ============================ Identity ============================
# Sent on every request. An honest, contactable UA turns "some bot is hammering
# us" into an email rather than a firewall rule. Point CONTACT_URL somewhere real.
BOT_NAME=UniversalExtractor
CONTACT_URL=https://example.invalid/bot
# Setting this to true sends a Chrome UA instead. Off by default: pretending to
# be a browser while behaving like a crawler is what robots.txt exists to avoid.
SPOOF_BROWSER_UA=false

# ======================= Compliance (Phase 1) =======================
RESPECT_ROBOTS=true
# What to do when robots.txt itself is unreachable: allow | deny.
ROBOTS_ON_UNAVAILABLE=allow
# Per-host politeness. These are the floor; a site's Crawl-delay only slows it.
REQUESTS_PER_SECOND=1.0
RATE_BURST=3
MAX_CONCURRENCY_PER_HOST=2
# A site asking for a longer gap than this is asking you not to crawl it.
MAX_CRAWL_DELAY=30
DETECT_BLOCKS=true
BREAKER_FAILURE_THRESHOLD=8
BREAKER_COOLDOWN=300
# SSRF guard. Leave false unless you are deliberately scraping localhost.
ALLOW_PRIVATE_ADDRESSES=false
# HOST_ALLOWLIST=example.com,other.test
# HOST_DENYLIST=

# ========================== Fetching ==========================
# PROXY_URL=http://user:pass@proxy.example.com:8080
USE_BROWSER_FALLBACK=true
STATIC_TIMEOUT=20
BROWSER_TIMEOUT_MS=30000
MAX_RETRIES=3
MAX_REDIRECTS=10
MAX_CONTENT_BYTES=67108864

# ====================== Universal input (Phase 2) ======================
MAX_RECURSION_DEPTH=2
MAX_ARCHIVE_MEMBERS=200
MAX_FEED_ENTRIES=100
MAX_SITEMAP_URLS=5000
# markitdown | docling (docling is slower but better on multi-column PDFs)
DOCUMENT_BACKEND=markitdown
OCR_ENABLED=true
# auto | vision | tesseract
OCR_BACKEND=auto
LIVESTREAM_SEGMENT_SECONDS=120
LIVESTREAM_MAX_MINUTES=120

# ================== Extraction cascade (Phase 3) ==================
ENABLE_TIER0_CACHE=true
ENABLE_TIER1_STRUCTURED=true
ENABLE_TIER2_SELECTORS=true
ENABLE_TIER3_LLM=true
# A tier's answer is accepted only if it filled this share of the fields.
MIN_FILL_RATE=0.5
# A stored selector spec below this is treated as drifted and relearned.
SPEC_DRIFT_FILL_RATE=0.4
SPEC_MAX_AGE_DAYS=30

# auto | ollama | groq. "auto" prefers Groq when a key is set.
LLM_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
AI_MODEL_NAME=llama3
AI_TIMEOUT=300
# GROQ_API_KEY=
# Structured outputs are per-model on Groq; openai/gpt-oss-* and qwen support
# json_schema. Others fall back to JSON mode plus validation on this side.
GROQ_MODEL=llama-3.3-70b-versatile
# Hard switch: never send page content to a hosted model.
LOCAL_ONLY=false
MAX_CHUNK_SIZE=12000

# ==================== Performance (Phase 4) ====================
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_SECONDS=86400
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_TTL_DAYS=30
RAW_STORE_ENABLED=true
RAW_STORE_TTL_DAYS=14
# auto | mlx | faster. Benchmark first:
#   PYTHONPATH=. ./venv/bin/python -m pipeline.transcribe.bench your-audio.mp3
WHISPER_BACKEND=auto
WHISPER_MODEL_SIZE=base
MLX_WHISPER_MODEL=mlx-community/whisper-base-mlx
# WHISPER_LANGUAGE=en
PRELOAD_MODELS=true

# ======================= Trust (Phase 5) =======================
VALIDATE_OUTPUT=true
# false keeps a flagged record (inspectable); true discards it.
REJECT_ON_VALIDATION_FAILURE=false
DEDUPE_ENABLED=true
SIMHASH_MAX_DISTANCE=3
DRIFT_ENABLED=true
DRIFT_MIN_SAMPLES=20
DRIFT_FILL_RATE_DROP=0.3

# ========================= Operations =========================
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
API_BASE_URL=http://127.0.0.1:8000
