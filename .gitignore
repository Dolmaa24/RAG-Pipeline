# Secrets — never commit.
# `.env` alone matches only that exact name, so a `.env.backup` or `.env.local`
# holding the same credentials would sail straight into a commit. Ignore the
# whole family and re-admit only the example, which has no real values in it.
.env
.env.*
!.env.example
*.pem
*.key

# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pipeline artifacts
output/

# Code the build workflow generated. Model-written, never reviewed by anyone
# unless someone chose to, and regenerated on every build — it is output, not
# source, and a commit of it would be a commit of something nobody wrote.
workspace/
temp_media_audio*
media_*/
live_*/
doc_*/
ocr_*/
*.mp3
*.wav
*.m4a

# Model and browser caches
.cache/
huggingface/

# Editors / OS
.DS_Store
.idea/
*.swp

# Vector store and knowledge graph
lance_data/
kuzu_db
kuzu_db/
kuzu_db.wal
chroma_data/
